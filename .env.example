# ===================================================================
# Variáveis de ambiente — Meta Conversions API (CAPI)
# ===================================================================
# Configure estas variáveis no Vercel:
#   Project Settings > Environment Variables
#
# Após criar/atualizar variáveis, faça um redeploy do projeto.
# ===================================================================

# OBRIGATÓRIA — Token de acesso da CAPI da Meta.
# Gere em: Business Manager > Eventos > seu Pixel > Configurações > Conversions API
META_ACCESS_TOKEN=cole_aqui_o_seu_token

# OPCIONAL — Se não definida, usa o ID padrão do código (1647727386472022).
# META_PIXEL_ID=1647727386472022

# OPCIONAL — Apenas para testes (Eventos de Teste no Gerenciador de Eventos).
# Remova/comente em produção.
# META_TEST_EVENT_CODE=TEST12345
